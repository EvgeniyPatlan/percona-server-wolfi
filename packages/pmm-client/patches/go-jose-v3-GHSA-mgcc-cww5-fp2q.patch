Subject: go-jose v3.0.5 (nomad): backport the GHSA-mgcc-cww5-fp2q fix and the JSON/CBC-HMAC hardening of v4.1.5/v4.1.6
Error: grype: GHSA-mgcc-cww5-fp2q (High, DoS when parsing RSA keys in a JWK), GHSA-vvm8-gf78-28g4 and
  GHSA-4w3g-jfj2-cw2q (Medium, panics in JSON parsing / CBC-HMAC) in /usr/local/percona/pmm/tools/nomad
Why: nomad (pmm_nomad_commit, and nomad main as of 2026-11-18) requires github.com/go-jose/go-jose/v3 v3.0.5, the last
  v3 release; the fixes exist only in v4 (v4.1.5, v4.1.6). nomad parses signed tokens with go-jose, and a JWS header
  can embed a JWK, so the RSA parsing path is reachable. v4 is a different import path, so a version bump is not
  possible; the recipe builds nomad against this patched copy (go.mod replace).
  Backported: a0111f8 (jwk.go: MaxRSAModulusBits = 4096, p*q == n check, jwk/epk headers parsed as public keys only;
  shared.go; jwe.go header sanitising after the recipients), a31af25 (json: nesting depth limit 10000), 6b364f3 and
  74114c2 (cipher/cbc_hmac: no panic on an invalid key size or empty ciphertext). Not backported: the jws.go reorder
  of a0111f8 (it moves v4's signature-algorithm allowlist check, which v3 does not have). v3's getJWK helper is kept
  (its tests use it) and parses public keys only. backport_test.go: the modulus limit (fails on unpatched v3.0.5)
  and a JWS whose jwk header holds a private key.
Upstream: https://github.com/go-jose/go-jose/security/advisories/GHSA-mgcc-cww5-fp2q (fixed in v4.1.6 only)
Drop-when: nomad moves to go-jose v4, or a fixed v3 release exists

diff --git a/backport_test.go b/backport_test.go
new file mode 100644
index 0000000..96c1845
--- /dev/null
+++ b/backport_test.go
@@ -0,0 +1,57 @@
+package jose
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+// GHSA-mgcc-cww5-fp2q backport: RSA moduli above MaxRSAModulusBits are rejected, and a "jwk" header must not carry
+// private key material.
+func TestBackportRSAModulusLimit(t *testing.T) {
+	n := new(big.Int).Lsh(big.NewInt(1), 4096) // 4097 bits (MaxRSAModulusBits is 4096)
+	n.Add(n, big.NewInt(1))
+	raw := map[string]string{
+		"kty": "RSA",
+		"n":   base64.RawURLEncoding.EncodeToString(n.Bytes()),
+		"e":   "AQAB",
+	}
+	b, _ := json.Marshal(raw)
+	var k JSONWebKey
+	if err := k.UnmarshalJSON(b); err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized modulus accepted: %v", err)
+	}
+}
+
+func TestBackportPrivateJWKHeaderRejected(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	priv, err := JSONWebKey{Key: key}.MarshalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	pub, err := JSONWebKey{Key: &key.PublicKey}.MarshalJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	enc := func(jwk []byte) string {
+		h := `{"alg":"RS256","jwk":` + string(jwk) + `}`
+		return base64.RawURLEncoding.EncodeToString([]byte(h)) + ".e30.AAAA"
+	}
+	if _, err := ParseSigned(enc(priv)); err == nil {
+		t.Fatal("JWS with a private key in its jwk header was accepted")
+	}
+	obj, err := ParseSigned(enc(pub))
+	if err != nil {
+		t.Fatalf("JWS with a public jwk header rejected: %v", err)
+	}
+	if obj.Signatures[0].Header.JSONWebKey == nil {
+		t.Fatal("public jwk header not parsed")
+	}
+}
