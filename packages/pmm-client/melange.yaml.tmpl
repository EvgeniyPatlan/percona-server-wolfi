            /usr/local/percona/pmm/tools/nomad version | grep -F "Nomad v@@pmm_nomad_version@@"

  # tools/: pt-summary and pt-mysql-summary are links to this repository's percona-toolkit package (the tarball
  # copies them from the PMM-pinned toolkit tree); pt-mongodb-summary and pt-pg-summary are built above.
  - name: pmm-client-tools
    description: Percona Toolkit summaries in the PMM client tools directory
    dependencies:
      runtime:
        - percona-toolkit
    pipeline:
      - runs: |
          set -eu
          s="${{targets.subpkgdir}}" t=usr/local/percona/pmm/tools
          install -o 1002 -g 0 -Dm0755 bin/pt-mongodb-summary "$s/$t/pt-mongodb-summary"
          install -o 1002 -g 0 -Dm0755 bin/pt-pg-summary "$s/$t/pt-pg-summary"
          ln -s /usr/bin/pt-summary "$s/$t/pt-summary"
          ln -s /usr/bin/pt-mysql-summary "$s/$t/pt-mysql-summary"
          install -Dm0644 percona-toolkit/COPYING "$s/usr/share/licenses/pmm-client-tools/COPYING"
    test:
      environment:
        contents:
          repositories:
            - https://packages.wolfi.dev/os
          keyring:
            - https://packages.wolfi.dev/os/wolfi-signing.rsa.pub
          packages:
            - wolfi-base
            - busybox
            - bash
            # the summary scripts need GNU awk/sed/grep/coreutils (busybox's fail); the image installs the same set
            - gawk
            - sed
            - grep
            - coreutils
      pipeline:
        - runs: |
            t=/usr/local/percona/pmm/tools
            $t/pt-mongodb-summary --version
            $t/pt-pg-summary --version
            # pt-summary --version prints the version and then exits 1 (upstream's option parser): check the text
            v=$($t/pt-summary --version || true)
            echo "$v"
            case $v in "pt-summary "*) ;; *) echo "pt-summary --version printed: $v" >&2; exit 1 ;; esac
            $t/pt-mysql-summary --version

test:
  environment:
    contents:
      repositories:
        - https://packages.wolfi.dev/os
      keyring:
        - https://packages.wolfi.dev/os/wolfi-signing.rsa.pub
      packages:
        - wolfi-base
        - busybox
        - bash
        - pmm-client
  pipeline:
    - name: versions
      runs: |
        b=/usr/local/percona/pmm/bin
        $b/pmm-agent --version 2>&1 | grep -F "Version: @@pmm_version@@"
        $b/pmm-agent --version 2>&1 | grep -F "@@pmm_commit@@"
        $b/pmm-admin --version 2>&1 | grep -F "Version: @@pmm_version@@"
        $b/pmm-agent-entrypoint --help > /dev/null 2>&1
    - name: setup fails cleanly without a server
      runs: |
        cd /tmp
        ! /usr/local/percona/pmm/bin/pmm-agent setup --config-file=/tmp/a.yaml --server-address=127.0.0.1:9 \
          --server-insecure-tls --paths-base=/usr/local/percona/pmm 127.0.0.1 generic test > out.txt 2>&1
        cat out.txt
    - name: layout
      runs: |
        p=/usr/local/percona/pmm
        for f in bin/pmm-agent bin/pmm-admin exporters/node_exporter exporters/mysqld_exporter exporters/vmagent \
          exporters/postgres_exporter exporters/mongodb_exporter exporters/proxysql_exporter exporters/rds_exporter \
          exporters/azure_exporter exporters/valkey_exporter tools/nomad tools/pt-pg-summary tools/pt-mongodb-summary; do
          test -x "$p/$f"
        done
        test -f $p/config/pmm-agent.yaml

update:
  enabled: false
